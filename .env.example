# Metta environment variables — NAMES ONLY.
#
# Never put a real credential in this file. It is committed to the repository.
# Copy it to .env for local development, and set the real values in your
# hosting provider's environment settings for deployment.
#
# scripts/scan-secrets.js checks that no real credential ever lands in a
# tracked file, and it runs in CI.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local development uses SQLite; production uses Postgres.
#   local:      file:./dev.db
#   production: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------------------
# Signs session and verification tokens. At least 32 characters.
# Generate with: openssl rand -base64 48
# Rotating this signs everyone out — which is the intended emergency action.
BETTER_AUTH_SECRET=

# The canonical public origin of the app, with no trailing slash.
# MUST be https:// in production.
APP_URL=

# Optional: only if the auth server lives at a different origin than the app.
BETTER_AUTH_URL=

# ---------------------------------------------------------------------------
# Encryption for Plaid access tokens (required in production)
# ---------------------------------------------------------------------------
# Base64-encoded 32-byte keys, one per generation, so keys can be rotated
# without re-linking anyone's bank. See SECRET_ROTATION.md.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY_V1=
# ENCRYPTION_KEY_V2=
# Which generation new writes use. Old rows keep decrypting with their own.
ENCRYPTION_KEY_ACTIVE=v1

# ---------------------------------------------------------------------------
# Plaid (required for real bank connections)
# ---------------------------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Absolute https URL Plaid calls with Item updates:
#   https://your-domain.example/api/plaid/webhook
PLAID_WEBHOOK_URL=
# Comma-separated allowlist of OAuth redirect URIs registered in the Plaid
# dashboard. The browser never chooses the redirect.
PLAID_REDIRECT_URIS=

# Point the Plaid client at a stand-in instead of Plaid. DEVELOPMENT ONLY —
# it is ignored when NODE_ENV=production, because a variable that can redirect
# bank credentials to another host must not be something a production
# environment can switch on. Used with scripts/e2e/plaid-mock.mjs to exercise
# the link -> exchange -> sync path with no route to Plaid.
#   PLAID_API_BASE_URL=http://127.0.0.1:4599
PLAID_API_BASE_URL=

# ---------------------------------------------------------------------------
# AI (optional — every AI feature degrades gracefully without a key)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
# Global ceiling across ALL users per UTC day. 0 disables AI entirely.
AI_DAILY_LIMIT=1000
# Per-user ceiling, per that user's local day.
AI_USER_DAILY_LIMIT=60
# Tighter ceiling for accounts that have not confirmed their email.
AI_UNVERIFIED_DAILY_LIMIT=5

# ---------------------------------------------------------------------------
# Email (required in production — verification and password reset need it)
# ---------------------------------------------------------------------------
# resend | console   ("console" prints to the server log; development only)
EMAIL_PROVIDER=console
RESEND_API_KEY=
# e.g. Metta <no-reply@your-domain.example>
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Product flags
# ---------------------------------------------------------------------------
# Public registration. MUST stay "false" until every launch blocker in
# PRODUCTION_LAUNCH_CHECKLIST.md is cleared.
PUBLIC_SIGNUP_ENABLED=false
# Comma-separated emails allowed to register while public signup is closed.
SIGNUP_ALLOWLIST=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# REMOVED — do not re-add
# ---------------------------------------------------------------------------
# APP_PASSWORD was the old single shared password for the whole app. It has
# been replaced by real per-user accounts. If it is set in production, the app
# refuses to start, so that a leftover value cannot be mistaken for security.
