# ---- Plaid (bank connections) ----
# The app runs in DEMO MODE with sample data until you fill these in.
# Get free keys at https://dashboard.plaid.com/signup  (Team Settings -> Keys)
#
# Leave PLAID_ENV as "sandbox" to test with Plaid's fake banks (username: user_good,
# password: pass_good). Switch to "development" to link a few of your OWN real banks.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ---- AI assistant (optional) ----
# The Ask screen works out of the box with a built-in engine. Add a Claude API
# key here to upgrade it to full natural-language chat that can answer anything
# about your money. Get a key at https://console.anthropic.com -> API Keys.
# Leave blank to keep the free built-in engine.
ANTHROPIC_API_KEY=

# ---- Login (required when deployed!) ----
# Leave blank locally and the app opens with no sign-in. The moment the app is
# on the internet, set a strong password here — every screen then requires it.
# AUTH_SECRET signs the 30-day session cookies; use a long random string
# (e.g. run: openssl rand -hex 32).
APP_PASSWORD=
AUTH_SECRET=

# ---- Database ----
# Local: SQLite file, nothing to change.
# Deployed: switch to Postgres (npm run db:postgres) and put your hosted
# Postgres URL here (e.g. from https://neon.tech, free tier is plenty).
DATABASE_URL="file:./dev.db"
